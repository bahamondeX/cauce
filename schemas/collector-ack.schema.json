{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cauce:collector-ack:proposal-1",
  "title": "Cauce experimental proposal acknowledgement",
  "description": "A strict local ACK shape; it is not a verified Connectivity response contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["batch_id", "accepted_count"],
  "properties": {
    "batch_id": { "type": "string", "format": "uuid" },
    "accepted_count": { "type": "integer", "minimum": 1 }
  }
}
