{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cauce:collector-batch:proposal-1",
  "title": "Cauce experimental proposal batch envelope",
  "description": "A local adapter proposal only; this is not a Connectivity ingestion contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "batch_id", "events"],
  "properties": {
    "contract_version": { "const": "proposal-1" },
    "batch_id": { "type": "string", "format": "uuid" },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "urn:cauce:access-log:1.1" }
    }
  }
}
