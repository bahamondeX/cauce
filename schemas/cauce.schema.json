{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cauce proxy configuration v1",
  "description": "Cauce check also validates addresses, converted durations, references and relationships between fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "proxy"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "proxy": {
      "$ref": "#/$defs/proxy"
    }
  },
  "$defs": {
    "environment": {
      "type": "string",
      "pattern": "^\\$\\{[A-Za-z_][A-Za-z_0-9]*\\}$"
    },
    "durationString": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h)$",
      "description": "The runtime checks unit conversion and range."
    },
    "sizeString": {
      "type": "string",
      "pattern": "^[0-9]+(B|KiB|MiB|GiB)$",
      "description": "The runtime checks byte conversion and field limits."
    },
    "identifier": {
      "anyOf": [
        {
          "$ref": "#/$defs/environment"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$"
        }
      ]
    },
    "authority": {
      "anyOf": [
        {
          "$ref": "#/$defs/environment"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clients",
        "requests",
        "connections",
        "idle_connections",
        "connecting",
        "acquire_ms",
        "connect_ms",
        "headers_ms",
        "stream_idle_ms",
        "request_ms",
        "client_headers_ms",
        "idle_connection_ms",
        "max_connection_age_ms",
        "dns_cache_ms",
        "tcp_keepalive_secs",
        "shutdown_ms",
        "max_header_bytes",
        "max_headers",
        "max_body_bytes"
      ],
      "properties": {
        "clients": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "connections": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "idle_connections": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "connecting": {
          "type": "integer",
          "minimum": 1
        },
        "acquire_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "connect_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "tls_handshake_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "headers_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "stream_idle_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "request_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "client_headers_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "idle_connection_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "max_connection_age_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "dns_cache_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "tcp_keepalive_secs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "shutdown_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "websocket_max_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "max_header_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 8192,
              "maximum": 1048576
            },
            {
              "$ref": "#/$defs/sizeString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "max_headers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_body_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "$ref": "#/$defs/sizeString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        }
      }
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "path",
        "queue",
        "rotate_bytes",
        "retained_files"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "queue": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "rotate_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 4096
            },
            {
              "$ref": "#/$defs/sizeString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "retained_files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cert_file",
        "key_file"
      ],
      "properties": {
        "cert_file": {
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "key_file": {
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      }
    },
    "upstreamTls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server_name",
        "ca_file"
      ],
      "properties": {
        "server_name": {
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            }
          ]
        },
        "ca_file": {
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "interval_ms",
        "timeout_ms",
        "rise",
        "fall"
      ],
      "properties": {
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^/[^#]*$"
            }
          ]
        },
        "interval_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 100,
              "maximum": 60000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "timeout_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 10,
              "maximum": 5000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "rise": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "fall": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "address",
        "host",
        "isolation",
        "connections",
        "idle_connections",
        "failure_backoff_ms"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "address": {
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "host": {
          "$ref": "#/$defs/authority"
        },
        "isolation": {
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          ]
        },
        "connections": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "idle_connections": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "failure_backoff_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "health_check": {
          "anyOf": [
            {
              "$ref": "#/$defs/health"
            },
            {
              "type": "null"
            }
          ]
        },
        "tls": {
          "anyOf": [
            {
              "$ref": "#/$defs/upstreamTls"
            },
            {
              "type": "null"
            }
          ]
        },
        "protocol": {
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "enum": [
                "http1",
                "http2"
              ]
            }
          ]
        },
        "streams_per_connection": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "host",
        "balance",
        "upstreams"
      ],
      "oneOf": [
        {
          "required": ["path_prefix"],
          "not": {
            "anyOf": [
              {"required": ["path_pattern"]},
              {"required": ["path_match"], "properties": {"path_match": {"enum": ["regex", "regex_insensitive"]}}}
            ]
          }
        },
        {
          "required": ["path_match", "path_pattern"],
          "not": {"required": ["path_prefix"]},
          "properties": {
            "path_match": {
              "anyOf": [
                {"$ref": "#/$defs/environment"},
                {"enum": ["regex", "regex_insensitive"]}
              ]
            }
          }
        }
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "host": {
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "type": "string",
              "pattern": "^[^*A-Z]+$"
            },
            {
              "type": "string",
              "maxLength": 261,
              "pattern": "^(\\*\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*|[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*\\.\\*)(:[0-9]{1,5})?$"
            }
          ]
        },
        "path_prefix": {
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^/[^?#%]*$"
            }
          ]
        },
        "path_match": {
          "default": "prefix",
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "enum": ["prefix", "exact", "literal_prefix", "prefix_no_regex", "regex", "regex_insensitive"]
            }
          ]
        },
        "path_pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "balance": {
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "enum": [
                "round_robin",
                "least_inflight"
              ]
            }
          ]
        },
        "upstreams": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "maxItems": 1024,
          "uniqueItems": true
        }
      }
    },
    "http2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max_concurrent_streams": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "initial_stream_window_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 16384,
              "maximum": 16777216
            },
            {
              "$ref": "#/$defs/sizeString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "initial_connection_window_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 65535,
              "maximum": 67108864
            },
            {
              "$ref": "#/$defs/sizeString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "max_send_buffer_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 16384,
              "maximum": 1048576
            },
            {
              "$ref": "#/$defs/sizeString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "max_pending_accept_reset_streams": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "max_local_error_reset_streams": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "listen",
        "admin",
        "limits",
        "logs",
        "upstreams",
        "routes"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "listen": {
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "admin": {
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "logs": {
          "$ref": "#/$defs/logs"
        },
        "tls": {
          "anyOf": [
            {
              "$ref": "#/$defs/tls"
            },
            {
              "type": "null"
            }
          ]
        },
        "http2": {
          "$ref": "#/$defs/http2"
        },
        "upstreams": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/upstream"
          },
          "maxItems": 1024
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/route"
          },
          "maxItems": 1024
        }
      }
    }
  }
}
