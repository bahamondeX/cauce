{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cauce proxy configuration v1",
  "description": "Cauce check also validates addresses, converted durations, references and relationships between fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "proxy"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "proxy": {
      "$ref": "#/$defs/proxy"
    }
  },
  "$defs": {
    "environment": {
      "type": "string",
      "pattern": "^\\$\\{[A-Za-z_][A-Za-z_0-9]*\\}$"
    },
    "durationString": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h)$",
      "description": "The runtime checks unit conversion and range."
    },
    "sizeString": {
      "type": "string",
      "pattern": "^[0-9]+(B|KiB|MiB|GiB)$",
      "description": "The runtime checks byte conversion and field limits."
    },
    "identifier": {
      "anyOf": [
        {
          "$ref": "#/$defs/environment"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$"
        }
      ]
    },
    "authority": {
      "anyOf": [
        {
          "$ref": "#/$defs/environment"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clients",
        "requests",
        "connections",
        "idle_connections",
        "connecting",
        "acquire_ms",
        "connect_ms",
        "headers_ms",
        "stream_idle_ms",
        "request_ms",
        "client_headers_ms",
        "idle_connection_ms",
        "max_connection_age_ms",
        "dns_cache_ms",
        "tcp_keepalive_secs",
        "shutdown_ms",
        "max_header_bytes",
        "max_headers",
        "max_body_bytes"
      ],
      "properties": {
        "clients": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "connections": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "idle_connections": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "connecting": {
          "type": "integer",
          "minimum": 1
        },
        "acquire_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "connect_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "tls_handshake_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "headers_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "stream_idle_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "request_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "client_headers_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "idle_connection_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "max_connection_age_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "dns_cache_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "tcp_keepalive_secs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "shutdown_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "websocket_max_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "max_header_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 8192,
              "maximum": 1048576
            },
            {
              "$ref": "#/$defs/sizeString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "max_headers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_body_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "$ref": "#/$defs/sizeString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        }
      }
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "path",
        "queue",
        "rotate_bytes",
        "retained_files"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "queue": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "rotate_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 4096
            },
            {
              "$ref": "#/$defs/sizeString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "retained_files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "certificateFiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cert_file", "key_file"],
      "properties": {
        "cert_file": {
          "anyOf": [
            {"$ref": "#/$defs/environment"},
            {"type": "string", "minLength": 1}
          ]
        },
        "key_file": {
          "anyOf": [
            {"$ref": "#/$defs/environment"},
            {"type": "string", "minLength": 1}
          ]
        }
      }
    },
    "tlsVersions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["tls1.2", "tls1.3"]}
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cert_file",
        "key_file"
      ],
      "properties": {
        "sni": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)*$"
          },
          "additionalProperties": {"$ref": "#/$defs/certificateFiles"}
        },
        "client_ca_file": {
          "anyOf": [
            {"$ref": "#/$defs/environment"},
            {"type": "string", "minLength": 1}
          ]
        },
        "versions": {"$ref": "#/$defs/tlsVersions"},
        "session_resumption": {"type": "boolean"},
        "cert_file": {
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "key_file": {
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      }
    },
    "upstreamTls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server_name",
        "ca_file"
      ],
      "properties": {
        "client_certificate": {"$ref": "#/$defs/certificateFiles"},
        "versions": {"$ref": "#/$defs/tlsVersions"},
        "session_resumption": {"type": "boolean"},
        "server_name": {
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            }
          ]
        },
        "ca_file": {
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interval_ms",
        "timeout_ms",
        "rise",
        "fall"
      ],
      "if": {
        "required": ["mode"],
        "properties": {"mode": {"const": "grpc"}}
      },
      "then": {"not": {"required": ["path"]}},
      "else": {
        "required": ["path"],
        "not": {"required": ["service"]}
      },
      "properties": {
        "mode": {
          "enum": ["http", "grpc"],
          "default": "http"
        },
        "service": {
          "type": "string",
          "maxLength": 256
        },
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^/[^#]*$"
            }
          ]
        },
        "interval_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 100,
              "maximum": 60000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "timeout_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 10,
              "maximum": 5000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "rise": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "fall": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "address",
        "host",
        "isolation",
        "connections",
        "idle_connections",
        "failure_backoff_ms"
      ],
      "if": {
        "required": ["health_check"],
        "properties": {
          "health_check": {
            "type": "object",
            "required": ["mode"],
            "properties": {"mode": {"const": "grpc"}}
          }
        }
      },
      "then": {
        "required": ["protocol"],
        "properties": {"protocol": {"const": "http2"}}
      },
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "address": {
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "host": {
          "$ref": "#/$defs/authority"
        },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64,
            "default": 1
          },
        "isolation": {
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          ]
        },
        "connections": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "idle_connections": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "failure_backoff_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            },
            {
              "$ref": "#/$defs/durationString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "health_check": {
          "anyOf": [
            {
              "$ref": "#/$defs/health"
            },
            {
              "type": "null"
            }
          ]
        },
        "tls": {
          "anyOf": [
            {
              "$ref": "#/$defs/upstreamTls"
            },
            {
              "type": "null"
            }
          ]
        },
        "protocol": {
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "enum": [
                "http1",
                "http2"
              ]
            }
          ]
        },
        "streams_per_connection": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "cidrs": {"type":"array","minItems":1,"maxItems":256,"uniqueItems":true,"items":{"type":"string","minLength":3,"maxLength":49}},
    "localPath": {
      "anyOf": [
        {"type": "string", "pattern": "^/"},
        {"$ref": "#/$defs/environment"}
      ]
    },
    "contentHandler": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "oneOf": [
            {
              "required": [
                "root"
              ]
            },
            {
              "required": [
                "alias"
              ]
            }
          ],
          "properties": {
            "type": {
              "const": "static"
            },
            "root": {
              "$ref": "#/$defs/localPath"
            },
            "alias": {
              "$ref": "#/$defs/localPath"
            },
            "expires_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "max_open": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "cache_control": {
              "type": "string"
            },
            "index": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              }
            },
            "try_files": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              }
            },
            "deny_suffixes": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              }
            },
            "precompressed": {"type": "boolean"},
            "listing": {
              "type": "boolean"
            },
            "hidden": {
              "type": "boolean"
            },
            "etag": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "status"
          ],
          "properties": {
            "type": {
              "const": "direct"
            },
            "status": {
              "type": "integer",
              "minimum": 200,
              "maximum": 599,
              "not": {
                "const": 304
              }
            },
            "body": {
              "type": "string",
              "maxLength": 16384
            },
            "content_type": {
              "type": "string"
            }
          }
        }
      ]
    },
    "compression": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithms": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["gzip", "br"]}},
        "min_size": {"anyOf": [{"type": "integer", "minimum": 0}, {"$ref": "#/$defs/sizeString"}, {"$ref": "#/$defs/environment"}]},
        "gzip_level": {"type": "integer", "minimum": 0, "maximum": 9},
        "brotli_level": {"type": "integer", "minimum": 0, "maximum": 6},
        "max_inflight": {"type": "integer", "minimum": 1, "maximum": 32},
        "mime": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "maxLength": 80}}
      }
    },
    "memoryCache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_size": {"anyOf": [{"type": "integer", "minimum": 4096, "maximum": 268435456}, {"$ref": "#/$defs/sizeString"}, {"$ref": "#/$defs/environment"}]},
        "max_entry_size": {"anyOf": [{"type": "integer", "minimum": 1, "maximum": 4194304}, {"$ref": "#/$defs/sizeString"}, {"$ref": "#/$defs/environment"}]},
        "max_entries": {"type": "integer", "minimum": 1, "maximum": 32768},
        "max_fills": {"type": "integer", "minimum": 1, "maximum": 128},
        "max_waiters": {"type": "integer", "minimum": 1, "maximum": 256},
        "ttl": {"$ref": "#/$defs/cacheDuration"},
        "stale_if_error": {"$ref": "#/$defs/cacheDuration"},
        "stale_while_revalidate": {"$ref": "#/$defs/cacheDuration"},
        "coalesce": {"type": "boolean"},
        "invalidate_on_write": {"type": "boolean"},
        "vary": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
        "bypass_header": {"type": "string", "minLength": 1, "maxLength": 64},
        "statuses": {"type": "array", "minItems": 1, "maxItems": 7, "items": {"enum": [200, 203, 204, 301, 308, 404, 410]}}
      }
    },
    "cacheDuration": {
      "anyOf": [{"type": "integer", "minimum": 0, "maximum": 604800000}, {"$ref": "#/$defs/durationString"}, {"$ref": "#/$defs/environment"}]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "host"
      ],
      "oneOf": [
        {
          "required": ["path_prefix"],
          "not": {
            "anyOf": [
              {"required": ["path_pattern"]},
              {"required": ["path_match"], "properties": {"path_match": {"enum": ["regex", "regex_insensitive", "named"]}}}
            ]
          }
        },
        {
          "required": ["path_match", "path_pattern"],
          "not": {"required": ["path_prefix"]},
          "properties": {
            "path_match": {
              "anyOf": [
                {"$ref": "#/$defs/environment"},
                {"enum": ["regex", "regex_insensitive", "named"]}
              ]
            }
          }
        }
      ],
      "properties": {
        "cache": {"$ref": "#/$defs/memoryCache"},
        "compression": {"$ref": "#/$defs/compression"},
        "content": {"$ref": "#/$defs/contentHandler"},
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "host": {
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "type": "string",
              "pattern": "^[^*A-Z]+$"
            },
            {
              "type": "string",
              "maxLength": 261,
              "pattern": "^(\\*\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*|[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*\\.\\*)(:[0-9]{1,5})?$"
            }
          ]
        },
        "path_prefix": {
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^/[^?#%]*$"
            }
          ]
        },
        "path_match": {
          "default": "prefix",
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "enum": ["prefix", "exact", "literal_prefix", "prefix_no_regex", "regex", "regex_insensitive", "named"]
            }
          ]
        },
        "path_pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "headers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "request": {"$ref": "#/$defs/headerEdits"},
            "response": {"$ref": "#/$defs/headerEdits"}
          }
        },
          "action": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "location"
                ],
                "properties": {
                  "kind": {
                    "const": "named"
                  },
                  "location": {
                    "$ref": "#/$defs/identifier"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "target"
                ],
                "properties": {
                  "kind": {
                    "const": "rewrite"
                  },
                  "target": {
                    "type": "string",
                    "maxLength": 512,
                    "pattern": "^/"
                  },
                  "pattern": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "query": {
                    "enum": [
                      "preserve",
                      "replace"
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "status",
                  "target"
                ],
                "properties": {
                  "kind": {
                    "const": "redirect"
                  },
                  "status": {
                    "enum": [
                      301,
                      302,
                      303,
                      307,
                      308
                    ]
                  },
                  "target": {
                    "type": "string",
                    "maxLength": 512,
                    "pattern": "^/"
                  },
                  "pattern": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "query": {
                    "enum": [
                      "preserve",
                      "replace"
                    ]
                  }
                }
              }
            ]
          },
          "allow_clients": {
            "$ref": "#/$defs/cidrs"
          },
          "rate_zone": {
            "$ref": "#/$defs/identifier"
          },
        "balance": {
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "enum": [
                "round_robin",
                "least_inflight",
                "weighted_round_robin",
                "least_connections",
                "weighted_least_connections",
                "ip_hash",
                "consistent_hash",
                "power_of_two_choices"
              ]
            }
          ]
        },
        "upstreams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "maxItems": 1024,
          "uniqueItems": true
        }
      }
    },
    "headerEdits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "set": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {"$ref": "#/$defs/editableHeaderName"},
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[ -~]*$"
          }
        },
        "remove": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/editableHeaderName"}
        }
      }
    },
    "editableHeaderName": {
      "type": "string",
      "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]{1,64}$"
    },
    "http2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max_concurrent_streams": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "initial_stream_window_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 16384,
              "maximum": 16777216
            },
            {
              "$ref": "#/$defs/sizeString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "initial_connection_window_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 65535,
              "maximum": 67108864
            },
            {
              "$ref": "#/$defs/sizeString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "max_send_buffer_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 16384,
              "maximum": 1048576
            },
            {
              "$ref": "#/$defs/sizeString"
            },
            {
              "$ref": "#/$defs/environment"
            }
          ]
        },
        "max_pending_accept_reset_streams": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "max_local_error_reset_streams": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "listen",
        "admin",
        "limits",
        "logs",
        "upstreams",
        "routes"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "listen": {
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "admin": {
          "anyOf": [
            {
              "$ref": "#/$defs/environment"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "logs": {
          "$ref": "#/$defs/logs"
        },
        "tls": {
          "anyOf": [
            {
              "$ref": "#/$defs/tls"
            },
            {
              "type": "null"
            }
          ]
        },
        "http2": {
          "$ref": "#/$defs/http2"
        },
        "upstreams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/upstream"
          },
          "maxItems": 1024
        },
          "real_ip": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trusted_proxies"
            ],
            "properties": {
              "trusted_proxies": {
                "$ref": "#/$defs/cidrs"
              },
              "header": {
                "enum": [
                  "x_forwarded_for",
                  "x_real_ip"
                ]
              },
              "recursive": {
                "type": "boolean"
              },
              "forwarding": {
                "enum": [
                  "replace",
                  "preserve_trusted_chain"
                ]
              }
            }
          },
          "max_connections_per_peer": {
            "type": "integer",
            "minimum": 1
          },
          "rate_zones": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
              "$ref": "#/$defs/identifier"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "max_keys"
              ],
              "anyOf": [
                {
                  "required": [
                    "rate_per_second"
                  ]
                },
                {
                  "required": [
                    "max_concurrent"
                  ]
                }
              ],
              "properties": {
                "key": {
                  "enum": [
                    "route",
                    "client_ip"
                  ]
                },
                "max_keys": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65536
                },
                "rate_per_second": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "burst": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65536
                },
                "max_delay_ms": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 30000
                },
                "max_concurrent": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65536
                },
                "reject_status": {
                  "type": "integer",
                  "minimum": 400,
                  "maximum": 599
                },
                "error_body": {
                  "type": "string",
                  "maxLength": 4096
                }
              }
            }
          },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/route"
          },
          "maxItems": 1024
        }
      }
    }
  }
}
