worker_processes 1;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;
events { worker_connections 1024; }
http {
  keepalive_requests 100000;
  limit_conn_zone $server_name zone=clientconn:10m;
  limit_conn_log_level info;
  map $http_upgrade $connection_upgrade { default upgrade; '' ''; }
  log_format increment7 escape=json '{"schema":"increment7.nginx.v1","request_id":"$request_id","method":"$request_method","path":"$uri","protocol":"$server_protocol","status":$status,"response_bytes":$body_bytes_sent,"request_time_s":"$request_time","pool_wait_ms":null,"upstream_connect_time_s":"$upstream_connect_time","upstream_header_time_s":"$upstream_header_time","upstream_response_time_s":"$upstream_response_time"}';
  __ACCESS_LOG__
  client_header_timeout 5s;
  client_body_timeout 15s;
  send_timeout 15s;
  client_max_body_size 16m;
  keepalive_timeout 15s;
  upstream app {
    server backend:__BACKEND_PORT__ max_conns=32;
    keepalive 32;
    keepalive_timeout 15s;
    keepalive_time 60s;
    keepalive_requests 100000;
  }
  server {
    listen __LISTEN__;
    server_name proxy proxy.test;
    __TLS__
    location / {
      limit_conn clientconn 32;
      limit_conn_status 503;
      proxy_pass __UPSTREAM_SCHEME__://app;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host backend.test:__BACKEND_PORT__;
      __UPSTREAM_TLS__
      proxy_buffering off;
      proxy_request_buffering off;
      proxy_connect_timeout 1s;
      proxy_read_timeout 15s;
      proxy_send_timeout 15s;
      proxy_next_upstream off;
    }
  }
}
