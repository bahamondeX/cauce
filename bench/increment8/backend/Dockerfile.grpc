FROM python:3.12.10-slim-bookworm@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db
WORKDIR /bench
RUN pip install --no-cache-dir grpcio==1.85.1 typing-extensions==4.16.0
COPY grpc_server.py ./grpc_server.py
USER 10001:10001
EXPOSE 50051 50052 9001
CMD ["python", "/bench/grpc_server.py"]
